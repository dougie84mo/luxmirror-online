# Public (exposed to the browser — safe values only)
NEXT_PUBLIC_SITE_URL=https://theluxmirror.com
NEXT_PUBLIC_SUPABASE_URL=https://ywmeghkhswixaueptfrt.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Google. Both optional — each feature stays completely off when unset, so
# dev and preview builds never pollute the property. Set them in the
# Hostinger panel, not here: the panel overrides .env.production at build
# time. See prompts/SEO_RUNBOOK.md
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Server-only (never prefix with NEXT_PUBLIC_)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Sales tax on LUX checkouts (deposit). Requires Stripe Tax activated +
# registrations, or session creation fails. See prompts/SALES_TAX_RUNBOOK.md
STRIPE_TAX_ENABLED=false
