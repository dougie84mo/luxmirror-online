# Public (exposed to the browser — safe values only)
NEXT_PUBLIC_SITE_URL=https://theluxmirror.com
NEXT_PUBLIC_SUPABASE_URL=https://ywmeghkhswixaueptfrt.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Not read by any code today — the deposit flow is entirely server-side
# (Server Actions → src/lib/stripe.ts). Kept as a placeholder for whenever a
# client-side Stripe.js element lands. Safe to leave blank.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Google. Both optional — each feature stays completely off when unset, so
# dev and preview builds never pollute the property. Set them in the
# Hostinger panel, not here: the panel overrides .env.production at build
# time. See prompts/SEO_RUNBOOK.md
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Server-only (never prefix with NEXT_PUBLIC_)
#
# STRIPE_MODE picks which secret key below is used: test | live (default test).
# src/lib/stripe.ts refuses to call Stripe when the key prefix contradicts the
# mode, in either direction. STRIPE_SECRET_KEY (unsuffixed) is the fallback and
# is what production sets today.
STRIPE_MODE=test
STRIPE_SECRET_KEY_TEST=
STRIPE_SECRET_KEY_LIVE=
STRIPE_SECRET_KEY=
# Not read by this app — the webhook is the stripe-webhook Edge Function, and
# its secret is a Supabase secret (`supabase secrets set`), not a value here.
STRIPE_WEBHOOK_SECRET=

# Sales tax on LUX checkouts (deposit). Requires Stripe Tax activated +
# registrations, or session creation fails. See prompts/SALES_TAX_RUNBOOK.md
STRIPE_TAX_ENABLED=false
